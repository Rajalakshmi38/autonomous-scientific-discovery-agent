# Copy this file to ".env" (Copy-Item .env.example .env).  ".env" is git-ignored.
# NO API KEY, ACCOUNT OR PAYMENT IS NEEDED for anything in this project.

# --- LLM -------------------------------------------------------------------
# test   = rule-based MOCK for plumbing tests. It is NOT an LLM and does not reason. (default)
# ollama = free local model served by Ollama (https://ollama.com). Needs: requirements-llm.txt
LLM_PROVIDER=test
# Pick a size your PC can run: python -m src.main check-system
# Example tags (confirm at https://ollama.com/library): llama3.2:1b, llama3.2:3b, llama3.1:8b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
# Context window in tokens. Keep >= 4096 so long prompts are not silently truncated.
OLLAMA_NUM_CTX=4096
LLM_MAX_TOKENS=700
# Local CPU inference can be slow; seconds before giving up on one call.
LLM_TIMEOUT_SECONDS=300

# --- Embeddings (all free) -----------------------------------------------------
# hashing               = built-in LEXICAL baseline (keyword overlap, not semantic). Default.
# ollama                = semantic, via Ollama (run: ollama pull nomic-embed-text). No PyTorch.
# sentence-transformers = semantic, via PyTorch (pip install sentence-transformers; big download)
# This example uses ollama (run: ollama pull nomic-embed-text). Without any .env file the program uses hashing.
# After changing this, run: python -m src.main reindex
EMBEDDING_BACKEND=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_MIN_SCORE=0.0

# --- RAG and repair loop -----------------------------------------------------------
# Max characters of paper text sent to the model (keep it within OLLAMA_NUM_CTX).
CONTEXT_CHAR_BUDGET=6000
# If an answer cites no retrieved paper, ask again this many times (0 disables).
CITATION_RETRIES=1
# After a failed sandbox run, ask the model for a fix this many times. Total runs = 1 + this.
# NOTE: this is a bounded error-feedback loop. It is NOT reinforcement learning.
MAX_REPAIR_RETRIES=2

# --- Docker sandbox (needs Docker Desktop; build the image once: python -m src.main sandbox-build)
DOCKER_COMMAND=docker
SANDBOX_IMAGE=asda-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=64
SANDBOX_MAX_OUTPUT_KB=64

# --- Statistical critic (checks experiment numbers; plain statistics, no language model)
# Significance level. A significant result is not proof that a hypothesis is true.
CRITIC_ALPHA=0.05

# --- How experiments are made ------------------------------------------------------------------
# spec = the model DESIGNS the experiment (dataset, two methods, metric) and vetted code writes the script.
#        Reliable with small local models. Experiments are limited to comparing two methods or settings
#        on a small bundled dataset (iris, wine, breast_cancer, digits).
# free = the model writes the whole Python script itself. Unrestricted, but small models often fail.
CODE_MODE=spec
SPEC_RETRIES=2
# Size of the "earlier attempts" note given to the model (characters). 0 turns the note off.
MEMORY_CHAR_BUDGET=1200
# Unload the language model from RAM before the sandbox starts (helps small laptops).
UNLOAD_MODEL_BEFORE_RUN=true
# Optional vision model that describes figures, for example one you pulled with Ollama. Empty = off.
FIGURE_VLM_MODEL=

# --- arXiv (free, no key) ---------------------------------------------------------
# arXiv asks API users to identify themselves; your email is optional but polite.
ARXIV_CONTACT=
ARXIV_TIMEOUT_SECONDS=30
ARXIV_RETRIES=3
ARXIV_DELAY_SECONDS=3

# --- Paths / logging -----------------------------------------------------------------
STORAGE_DIR=storage
DATA_DIR=data
LOG_LEVEL=INFO
